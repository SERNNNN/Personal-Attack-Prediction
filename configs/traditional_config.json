{
  "experiment_name": "traditional_early_prediction",
  "dataset": {
    "path": "data/conversations_clean.csv",
    "output_dir": "results/traditional",
    "text_column": "text",
    "label_column": "label",
    "split_column": "split",
    "conversation_id_column": "conversation_id",
    "pair_id_column": "pair_id",
    "utterance_separator": "\u25aa\u25e6\u25aa",
    "train_split": "train",
    "validation_split": "val",
    "test_split": "test"
  },
  "early_prediction": {
    "stages_percent": [
      20,
      40,
      60,
      80,
      100
    ],
    "prefix_unit": "utterances",
    "rounding": "ceil",
    "minimum_prefix_utterances": 1
  },
  "model": {
    "type": "sgd_log_loss",
    "tfidf": {
      "ngram_range": [
        1,
        2
      ],
      "max_features": 50000,
      "min_df": 2,
      "sublinear_tf": true
    },
    "classifier": {
      "loss": "log_loss",
      "penalty": "l2",
      "alpha": 0.0001,
      "max_iter": 20,
      "tol": null,
      "shuffle": true,
      "learning_rate": "optimal"
    }
  },
  "training": {
    "random_seed": 42,
    "fit_on_train_split_only": true
  },
  "evaluation": {
    "metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1",
      "roc_auc",
      "pr_auc"
    ]
  },
  "output": {
    "directory": "results/traditional"
  }
}